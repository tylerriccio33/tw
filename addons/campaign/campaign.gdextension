[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1

[libraries]

macos.debug = "res://addons/campaign/bin/libcampaign.dylib"
macos.release = "res://addons/campaign/bin/libcampaign.dylib"

linux.debug.x86_64 = "res://addons/campaign/bin/libcampaign.linux.debug.x86_64.so"
linux.release.x86_64 = "res://addons/campaign/bin/libcampaign.linux.release.x86_64.so"

windows.debug.x86_64 = "res://addons/campaign/bin/libcampaign.windows.debug.x86_64.dll"
windows.release.x86_64 = "res://addons/campaign/bin/libcampaign.windows.release.x86_64.dll"
