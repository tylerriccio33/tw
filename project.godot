; Godot project configuration.

config_version=5

[application]

config/name="tw"
run/main_scene="res://campaign/campaign.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[debug]

; A GDScript type-inference warning (e.g. `var x := some_untyped_call()`,
; which infers Variant rather than a real type) is otherwise silent until it
; happens to misbehave at runtime - promoting it to a hard error lets
; `make check` (godot --check-only) catch it in about a second instead of
; losing a whole session to it.
gdscript/warnings/treat_warnings_as_errors=true

[rendering]

renderer/rendering_method="forward_plus"
; MSAA/FXAA off, TAA on: matches the campaign map's 2D province rendering
; plus the 3D knight army layer, which is the only remaining 3D content.
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true
