; Godot project configuration.
;
; The Terrain3D editor plugin is enabled here rather than through the editor
; GUI so that a fresh clone renders correctly with no manual setup. The
; GDExtension node classes register at runtime regardless of this line; the
; plugin only adds editor tooling.

config_version=5

[application]

config/name="tw"
run/main_scene="res://tools/shoot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

; The OS window stays tiny and offscreen. All capture happens through a
; SubViewport at full resolution, so iterating never hijacks the desktop.
window/size/viewport_width=128
window/size/viewport_height=128

[debug]

; A GDScript type-inference warning (e.g. `var x := some_untyped_call()`,
; which infers Variant rather than a real type) is otherwise silent until it
; happens to misbehave at runtime, mid-render, three stages deep - promoting
; it to a hard error lets `make check` (godot --check-only) catch it in
; about a second instead of losing a full render cycle to it.
gdscript/warnings/treat_warnings_as_errors=true

[importer_defaults]

; Terrain3D textures (assets/textures/) need mipmaps for the far-distance LOD
; blend it does between texture layers; Godot's texture import default is
; mipmaps off, which otherwise has to be flipped by hand per-file every time
; `make textures` re-vendors them into the (gitignored) assets/textures/ dir.
texture={
"mipmaps/generate": true
}

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
