# macOS
.DS_Store

# Godot
.godot/

# Vendored Quaternius CC0 building kit (unused by the 2D province map; kept
# on disk locally, no fetch target)
/assets/buildings/

# Vendored Quaternius CC0 knight model - run `make armies`
/assets/armies/

# Vendored GUT (GDScript unit-testing addon) - run `make gut`
/addons/gut/

# Download cache for the vendoring scripts (fetch_armies.py, fetch_gut.py) -
# large, re-fetchable, not meant to be committed.
/tools/vendor_cache/

# Python
**/__pycache__/
*.pyc
.pytest_cache
.ruff_cache
.venv/

# Node (map editor JS tooling)
node_modules/

# Rendered shots (scratch output of make play-shot / hud-shot / render-test).
/shots/play/
/shots/render_test/

# Reference/target mockups dropped at repo root during design work - not
# game assets, not meant to be committed.
/target-phase*.png
/target-phase*.png.import

# Editors
.vscode/
.idea/
*.swp

# Rust GDExtension build output - run `make campaign` to (re)build
/rust/target/
/rust/*/target/
/addons/campaign/bin/
