# macOS
.DS_Store

# Godot
.godot/

# Vendored GDExtension (42MB of prebuilt binaries) - run `make addons`
/addons/terrain_3d/

# Vendored ambientCG PBR textures - run `make textures`
/assets/textures/

# Vendored Poly Haven CC0 tree textures - run `make foliage`
/assets/foliage/

# Terrain3D region data. The terrain is regenerated from config/world.json on
# every run and never saved, so this is scratch.
/data/

# Python
**/__pycache__/
*.pyc

# Rendered shots. shots/golden/ IS committed - it is the diff baseline.
/shots/current/
/shots/contact_sheet.png
/shots/sheet.png
/shots/play/

# Editors
.vscode/
.idea/
*.swp

# Rust GDExtension build output - run `make campaign` to (re)build
/rust/target/
/rust/*/target/
/addons/campaign/bin/
